<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="AaramEducation.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title runat="server" id="PageTitle">aaram — stress-free online learning</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Atkinson+Hyperlegible+Mono:wght@400;700&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/wwwroot/lib/bootstrap/dist/css/bootstrap.min.css" runat="server" />
  <link rel="stylesheet" href="~/wwwroot/css/aaram.css" runat="server" />
  <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
  <form id="MainForm" runat="server">

    <nav class="navbar navbar-expand-lg navbar-aaram">
      <div class="container">
        <a class="aaram-brand" href='<%= ResolveUrl("~/Default.aspx") %>'>
          <span class="aaram-brand-name">aaram</span>
          <span class="aaram-brand-dot" aria-hidden="true"></span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"
                aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMain">
          <ul class="navbar-nav ms-4 me-auto align-items-lg-center">
            <li class="nav-item">
              <a class="nav-link <%= NavActive("Courses") %>" href='<%= ResolveUrl("~/Courses/Index.aspx") %>'>Courses</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= NavActive("Badges") %>" href='<%= ResolveUrl("~/Badges/Leaderboard.aspx") %>'>Leaderboard</a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= NavActive("Guestbook") %>" href='<%= ResolveUrl("~/Guestbook/Index.aspx") %>'>Guest book</a>
            </li>
          </ul>

          <ul class="navbar-nav align-items-lg-center gap-2">
            <% if (IsAuthenticated) { %>

              <% if (CurrentUserRole == "Admin") { %>
                <li class="nav-item"><a class="nav-link <%= NavActive("Admin") %>" href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>'>Admin</a></li>
              <% } else if (CurrentUserRole == "Tutor") { %>
                <li class="nav-item"><a class="nav-link <%= NavActive("Tutor") %>" href='<%= ResolveUrl("~/Tutor/Dashboard.aspx") %>'>My courses</a></li>
              <% } else { %>
                <li class="nav-item"><a class="nav-link <%= NavActivePage("Courses/MyEnrollments.aspx") %>" href='<%= ResolveUrl("~/Courses/MyEnrollments.aspx") %>'>My courses</a></li>
              <% } %>

              <li class="nav-item dropdown">
                <a class="nav-link position-relative" href="#" id="notifDropdown"
                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  🔔
                  <asp:Panel ID="pnlUnreadBadge" runat="server" Visible="false"
                             CssClass="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                             style="font-size:.65rem"><asp:Literal ID="litUnreadCount" runat="server" /></asp:Panel>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notifDropdown" style="min-width:320px">
                  <asp:Panel ID="pnlNotifyEmpty" runat="server" Visible="false">
                    <li><span class="dropdown-item text-muted">No notifications</span></li>
                  </asp:Panel>
                  <asp:Panel ID="pnlNotifyList" runat="server" Visible="false">
                    <asp:Repeater ID="rptNotifications" runat="server">
                      <ItemTemplate>
                        <li>
                          <div class='dropdown-item <%# (bool)Eval("IsRead") ? "" : "fw-semibold bg-light" %>'>
                            <div class="small"><%# Server.HtmlEncode((string)Eval("Title")) %></div>
                            <div class="text-muted" style="font-size:.8rem;white-space:normal"><%# Server.HtmlEncode((string)Eval("Message")) %></div>
                            <div class="text-muted" style="font-size:.7rem"><%# Eval("CreatedAt", "{0:d MMM HH:mm}") %></div>
                          </div>
                        </li>
                      </ItemTemplate>
                    </asp:Repeater>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                      <a class="dropdown-item text-center small" href='<%= ResolveUrl("~/Notifications/Index.aspx") %>'>View all</a>
                    </li>
                  </asp:Panel>
                </ul>
              </li>

              <li class="nav-item dropdown">
                <a class="user-pill" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <span class="user-avatar"><%= Server.HtmlEncode(UserInitials) %></span>
                  <span><%= Server.HtmlEncode(UserDisplayName) %></span>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <span class="dropdown-item-text" style="font-size:.8rem">
                      <span class="role-badge <%= CurrentUserRole.ToLower() %>"><%= CurrentUserRole %></span>
                    </span>
                  </li>
                  <li><hr class="dropdown-divider" /></li>
                  <li><a class="dropdown-item" href='<%= ResolveUrl("~/Progress/Dashboard.aspx") %>'>My dashboard</a></li>
                  <li><a class="dropdown-item" href='<%= ResolveUrl("~/Account/Profile.aspx") %>'>My profile</a></li>
                  <li><a class="dropdown-item" href='<%= ResolveUrl("~/Badges/Index.aspx") %>'>My badges</a></li>
                  <li><hr class="dropdown-divider" /></li>
                  <li>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="dropdown-item"
                                    OnClick="Logout_Click" Text="Sign out" />
                  </li>
                </ul>
              </li>

            <% } else { %>
              <li class="nav-item">
                <a class="nav-link" href='<%= ResolveUrl("~/Account/Login.aspx") %>'>Sign in</a>
              </li>
              <li class="nav-item">
                <a class="btn-aaram btn-aaram-primary btn-aaram-sm" href='<%= ResolveUrl("~/Account/Register.aspx") %>'>Join free</a>
              </li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <main role="main">
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="footer-aaram">
      <div class="container">
        <div class="row gy-4">
          <div class="col-lg-5">
            <div class="footer-brand">
              aaram<span class="aaram-brand-dot" aria-hidden="true"></span>
            </div>
            <p class="footer-tagline mb-0">
              Unhurried learning for school, college and anyone coming back to the basics.
            </p>
          </div>

          <div class="col-6 col-lg-3 offset-lg-1">
            <div class="footer-head">Learn</div>
            <nav class="d-flex flex-column align-items-start">
              <a href='<%= ResolveUrl("~/Courses/Index.aspx") %>'>Courses</a>
              <a href='<%= ResolveUrl("~/Courses/MyEnrollments.aspx") %>'>My courses</a>
              <a href='<%= ResolveUrl("~/Progress/Dashboard.aspx") %>'>My dashboard</a>
            </nav>
          </div>

          <div class="col-6 col-lg-3">
            <div class="footer-head">Community</div>
            <nav class="d-flex flex-column align-items-start">
              <a href='<%= ResolveUrl("~/Guestbook/Index.aspx") %>'>Guest book</a>
              <a href='<%= ResolveUrl("~/Account/Register.aspx") %>'>Teach on Aaram</a>
              <a href='<%= ResolveUrl("~/Badges/Leaderboard.aspx") %>'>Leaderboard</a>
            </nav>
          </div>
        </div>

        <div class="footer-rule">
          <span class="footer-copy">&copy; <%= DateTime.Now.Year %> Aaram Education, Techspire College</span>
        </div>
      </div>
    </footer>
  </form>

  <script src='<%= ResolveUrl("~/wwwroot/lib/jquery/dist/jquery.min.js") %>'></script>
  <script src='<%= ResolveUrl("~/wwwroot/lib/bootstrap/dist/js/bootstrap.bundle.min.js") %>'></script>
  <script src='<%= ResolveUrl("~/wwwroot/js/site.js") %>'></script>
  <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
