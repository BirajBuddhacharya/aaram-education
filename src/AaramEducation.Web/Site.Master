<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="AaramEducation.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title runat="server" id="PageTitle">aaram — stress-free online learning</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&display=swap" rel="stylesheet" />
  <link href="~/wwwroot/lib/bootstrap/dist/css/bootstrap.min.css" runat="server" rel="stylesheet" />
  <link href="~/wwwroot/css/aaram.css" runat="server" rel="stylesheet" />
  <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
  <form id="MainForm" runat="server">
    <nav class="navbar navbar-expand-lg" id="mainNav">
      <div class="container-xl">
        <a class="navbar-brand" href="~/Default.aspx" runat="server">aaram</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto align-items-center gap-2">
            <li class="nav-item"><a class="nav-link" href="~/Default.aspx" runat="server">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="~/Courses/Index.aspx" runat="server">Courses</a></li>
            <li class="nav-item"><a class="nav-link" href="~/Guestbook/Index.aspx" runat="server">Guestbook</a></li>
            <% if (IsAuthenticated) { %>
            <li class="nav-item"><a class="nav-link" href="~/Progress/Dashboard.aspx" runat="server">Dashboard</a></li>
            <li class="nav-item"><a class="nav-link" href="~/Notifications/Index.aspx" runat="server">Notifications</a></li>
            <% if (CurrentUserRole == "Admin") { %>
            <li class="nav-item"><a class="nav-link" href="~/Admin/Dashboard.aspx" runat="server">Admin</a></li>
            <% } %>
            <% if (CurrentUserRole == "Tutor") { %>
            <li class="nav-item"><a class="nav-link" href="~/Tutor/Dashboard.aspx" runat="server">My Courses</a></li>
            <% } %>
            <li class="nav-item"><a class="nav-link" href="~/Account/Profile.aspx" runat="server">Profile</a></li>
            <li class="nav-item">
              <asp:Button ID="btnLogout" runat="server" Text="Sign out" CssClass="btn btn-sm btn-outline-secondary" OnClick="Logout_Click" UseSubmitBehavior="true" />
            </li>
            <% } else { %>
            <li class="nav-item"><a class="btn btn-sm btn-outline-primary" href="~/Account/Login.aspx" runat="server">Sign in</a></li>
            <li class="nav-item"><a class="btn btn-sm btn-aaram-primary" href="~/Account/Register.aspx" runat="server">Get started</a></li>
            <% } %>
          </ul>
        </div>
      </div>
    </nav>

    <main role="main">
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="footer mt-auto py-4">
      <div class="container-xl text-center">
        <span class="t-small">&copy; <%= DateTime.Now.Year %> aaram education &mdash; stress-free online learning</span>
      </div>
    </footer>
  </form>

  <script src='<%= ResolveUrl("~/wwwroot/lib/jquery/dist/jquery.min.js") %>'></script>
  <script src='<%= ResolveUrl("~/wwwroot/lib/bootstrap/dist/js/bootstrap.bundle.min.js") %>'></script>
  <script src='<%= ResolveUrl("~/wwwroot/js/site.js") %>'></script>
  <asp:ContentPlaceHolder ID="ScriptsContent" runat="server" />
</body>
</html>
