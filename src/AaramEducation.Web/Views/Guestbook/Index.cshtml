@model AaramEducation.Web.Models.ViewModels.Guestbook.GuestbookIndexViewModel
@{ ViewData["Title"] = "Guestbook"; }

<div class="container py-4">
  <div class="row g-4">

    <div class="col-lg-7">
      <h1 class="mb-1">Guestbook</h1>
      <p class="text-muted mb-4">@Model.TotalCount message(s) from our community.</p>

      @if (TempData["Success"] is string msg)
      {
        <div class="alert alert-success">@msg</div>
      }

      @if (!Model.Entries.Any())
      {
        <p class="text-muted">No messages yet — be the first to leave one!</p>
      }
      else
      {
        @foreach (var e in Model.Entries)
        {
          <div class="card mb-3">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <h6 class="card-title mb-1">@e.GuestName</h6>
                <small class="text-muted">@e.SubmittedAt.ToString("d MMM yyyy")</small>
              </div>
              <p class="card-text">@e.Message</p>
            </div>
          </div>
        }

        @if (Model.TotalPages > 1)
        {
          <nav aria-label="Guestbook pages">
            <ul class="pagination">
              @for (int p = 1; p <= Model.TotalPages; p++)
              {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                  <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                </li>
              }
            </ul>
          </nav>
        }
      }
    </div>

    <div class="col-lg-5">
      <div class="card sticky-top" style="top:80px">
        <div class="card-header fw-semibold">Leave a Message</div>
        <div class="card-body">
          <form asp-action="Submit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

            <div class="mb-3">
              <label asp-for="SubmitForm.GuestName" class="form-label">Your name</label>
              <input asp-for="SubmitForm.GuestName" class="form-control" />
              <span asp-validation-for="SubmitForm.GuestName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
              <label asp-for="SubmitForm.GuestEmail" class="form-label">Email <small class="text-muted">(optional)</small></label>
              <input asp-for="SubmitForm.GuestEmail" class="form-control" type="email" />
              <span asp-validation-for="SubmitForm.GuestEmail" class="text-danger small"></span>
            </div>
            <div class="mb-3">
              <label asp-for="SubmitForm.Message" class="form-label">Message</label>
              <textarea asp-for="SubmitForm.Message" class="form-control" rows="4"
                        maxlength="1000" placeholder="Share your experience..."></textarea>
              <span asp-validation-for="SubmitForm.Message" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Submit</button>
          </form>
          <p class="text-muted small mt-2 mb-0">Messages are reviewed before appearing.</p>
        </div>
      </div>
    </div>

  </div>
</div>
