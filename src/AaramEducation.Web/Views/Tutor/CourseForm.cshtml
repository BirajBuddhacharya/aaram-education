@model AaramEducation.Web.Models.ViewModels.Tutor.CourseFormViewModel
@{
    var isEdit = Model.CourseId != 0;
    ViewData["Title"] = isEdit ? "Edit Course" : "Create Course";
}

<div class="container py-4" style="max-width:640px">
  <h1 class="mb-4">@ViewData["Title"]</h1>

  <form asp-action="@(isEdit ? "EditCourse" : "CreateCourse")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="CourseId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
      <label asp-for="CourseName" class="form-label">Course name</label>
      <input asp-for="CourseName" class="form-control" />
      <span asp-validation-for="CourseName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
      <label asp-for="CourseDescription" class="form-label">Description</label>
      <textarea asp-for="CourseDescription" class="form-control" rows="4"></textarea>
      <span asp-validation-for="CourseDescription" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-6">
        <label asp-for="Subject" class="form-label">Subject</label>
        <input asp-for="Subject" class="form-control" placeholder="e.g. Mathematics" />
        <span asp-validation-for="Subject" class="text-danger small"></span>
      </div>
      <div class="col-6">
        <label asp-for="DifficultyLevel" class="form-label">Difficulty</label>
        <select asp-for="DifficultyLevel" class="form-select">
          <option value="Beginner">Beginner</option>
          <option value="Intermediate">Intermediate</option>
          <option value="Advanced">Advanced</option>
        </select>
      </div>
    </div>

    <div class="mb-4 form-check">
      <input asp-for="IsPublished" class="form-check-input" />
      <label asp-for="IsPublished" class="form-check-label">Publish immediately</label>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create course")</button>
      <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
