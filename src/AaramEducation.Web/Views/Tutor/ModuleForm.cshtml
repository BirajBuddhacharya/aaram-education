@model AaramEducation.Web.Models.ViewModels.Tutor.ModuleFormViewModel
@{
    var isEdit = Model.ModuleId != 0;
    ViewData["Title"] = isEdit ? "Edit Module" : "Add Module";
}

<div class="container py-4" style="max-width:560px">
  <h1 class="mb-4">@ViewData["Title"]</h1>

  <form asp-action="@(isEdit ? "EditModule" : "CreateModule")" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ModuleId" />
    <input type="hidden" asp-for="CourseId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
      <label asp-for="ModuleName" class="form-label">Module name</label>
      <input asp-for="ModuleName" class="form-control" />
      <span asp-validation-for="ModuleName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
      <label asp-for="ModuleDescription" class="form-label">Description <span class="text-muted">(optional)</span></label>
      <textarea asp-for="ModuleDescription" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-4" style="max-width:120px">
      <label asp-for="SequenceOrder" class="form-label">Order</label>
      <input asp-for="SequenceOrder" class="form-control" type="number" min="1" />
      <span asp-validation-for="SequenceOrder" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">@(isEdit ? "Save" : "Add module")</button>
      <a asp-action="ManageCourse" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
