@model AaramEducation.Web.Models.ViewModels.Tutor.TutorDashboardViewModel
@{ ViewData["Title"] = "My Courses"; }

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1>My Courses</h1>
    <a asp-action="CreateCourse" class="btn btn-primary">+ Create Course</a>
  </div>

  @if (!Model.Courses.Any())
  {
    <div class="alert alert-info">No courses yet. Create your first course to get started.</div>
  }
  else
  {
    <div class="table-responsive">
      <table class="table align-middle">
        <thead>
          <tr>
            <th>Course</th>
            <th>Subject</th>
            <th>Level</th>
            <th>Status</th>
            <th>Enrolled</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in Model.Courses)
          {
            <tr>
              <td>
                <a asp-action="ManageCourse" asp-route-id="@row.Course.CourseId" class="fw-semibold text-decoration-none">
                  @row.Course.CourseName
                </a>
              </td>
              <td>@row.Course.Subject</td>
              <td>@row.Course.DifficultyLevel</td>
              <td>
                @if (row.Course.IsPublished)
                { <span class="badge bg-success">Published</span> }
                else
                { <span class="badge bg-secondary">Draft</span> }
              </td>
              <td>@row.EnrollmentCount</td>
              <td class="text-end">
                <a asp-action="ManageCourse" asp-route-id="@row.Course.CourseId" class="btn btn-sm btn-outline-primary">Manage</a>
                <a asp-action="EditCourse" asp-route-id="@row.Course.CourseId" class="btn btn-sm btn-outline-secondary">Edit</a>
                <form asp-action="DeleteCourse" asp-route-id="@row.Course.CourseId" method="post" class="d-inline"
                      onsubmit="return confirm('Delete @row.Course.CourseName? This cannot be undone.')">
                  @Html.AntiForgeryToken()
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>
