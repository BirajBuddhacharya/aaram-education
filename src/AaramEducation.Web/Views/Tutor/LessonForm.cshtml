@model AaramEducation.Web.Models.ViewModels.Tutor.LessonFormViewModel
@{
    var isEdit = Model.LessonId != 0;
    ViewData["Title"] = isEdit ? "Edit Lesson" : "Add Lesson";
}

<div class="container py-4" style="max-width:680px">
  <h1 class="mb-4">@ViewData["Title"]</h1>

  <form asp-action="@(isEdit ? "EditLesson" : "CreateLesson")" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LessonId" />
    <input type="hidden" asp-for="ModuleId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-3">
      <label asp-for="LessonTitle" class="form-label">Lesson title</label>
      <input asp-for="LessonTitle" class="form-control" />
      <span asp-validation-for="LessonTitle" class="text-danger small"></span>
    </div>

    <div class="mb-3">
      <label asp-for="LessonDescription" class="form-label">Description <span class="text-muted">(optional)</span></label>
      <textarea asp-for="LessonDescription" class="form-control" rows="2"></textarea>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-4">
        <label asp-for="SequenceOrder" class="form-label">Order</label>
        <input asp-for="SequenceOrder" class="form-control" type="number" min="1" />
      </div>
      <div class="col-8 d-flex align-items-end">
        <div class="form-check mb-2">
          <input asp-for="IsFreeSample" class="form-check-input" />
          <label asp-for="IsFreeSample" class="form-check-label">Free sample (visible without enrollment)</label>
        </div>
      </div>
    </div>

    <hr />
    <h5 class="mb-3">Video</h5>

    <div class="mb-3">
      <label asp-for="VideoUrl" class="form-label">Video URL</label>
      <input asp-for="VideoUrl" class="form-control" placeholder="https://youtube.com/... or /uploads/videos/file.mp4" />
      <div class="form-text">YouTube URLs are embedded; local paths served directly.</div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-8">
        <label asp-for="VideoTitle" class="form-label">Video title <span class="text-muted">(optional)</span></label>
        <input asp-for="VideoTitle" class="form-control" />
      </div>
      <div class="col-4">
        <label asp-for="DurationSeconds" class="form-label">Duration (s)</label>
        <input asp-for="DurationSeconds" class="form-control" type="number" min="0" />
      </div>
    </div>

    <hr />
    <h5 class="mb-3">Study Note</h5>

    <div class="mb-3">
      <label asp-for="NoteTitle" class="form-label">Note title</label>
      <input asp-for="NoteTitle" class="form-control" />
    </div>

    <div class="mb-3">
      <label asp-for="NoteContent" class="form-label">Note content <span class="text-muted">(optional)</span></label>
      <textarea asp-for="NoteContent" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-4">
      <label asp-for="NoteFile" class="form-label">Attach file <span class="text-muted">(optional — PDF, DOCX, etc.)</span></label>
      <input asp-for="NoteFile" type="file" class="form-control" />
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Add lesson")</button>
      <a href="javascript:history.back()" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
