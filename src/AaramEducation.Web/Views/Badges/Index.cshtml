@model AaramEducation.Web.Models.ViewModels.Gamification.BadgesViewModel
@{ ViewData["Title"] = "Badges"; }

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1>Badges</h1>
    <span class="badge bg-primary fs-6">@Model.EarnedCount / @Model.TotalCount earned</span>
  </div>

  <div class="row g-3">
    @foreach (var item in Model.Badges)
    {
      <div class="col-6 col-md-4 col-lg-3">
        <div class="card text-center h-100 @(item.Earned ? "" : "opacity-50")">
          <div class="card-body">
            <div class="badge-icon mb-2" style="font-size:3rem">
              @if (!string.IsNullOrWhiteSpace(item.Badge.IconUrl))
              {
                <img src="@item.Badge.IconUrl" alt="@item.Badge.BadgeName" width="64" height="64" />
              }
              else
              {
                <span>&#x1F3C5;</span>
              }
            </div>
            <h6 class="card-title">@item.Badge.BadgeName</h6>
            <p class="card-text text-muted small">@item.Badge.Description</p>
            <span class="badge bg-warning text-dark">+@item.Badge.XpReward XP</span>
            @if (item.Earned && item.EarnedAt.HasValue)
            {
              <p class="mt-2 text-success small">Earned @item.EarnedAt.Value.ToString("d MMM yyyy")</p>
            }
            else if (!item.Earned)
            {
              <p class="mt-2 text-muted small">Not yet earned</p>
            }
          </div>
        </div>
      </div>
    }
  </div>
</div>
