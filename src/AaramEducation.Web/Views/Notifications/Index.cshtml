@model IEnumerable<AaramEducation.Core.Entities.Notification>
@{ ViewData["Title"] = "Notifications"; }

<div class="container py-4" style="max-width:680px">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Notifications</h1>
    @if (Model.Any())
    {
      <form asp-action="MarkAllRead" method="post">
        @Html.AntiForgeryToken()
        <button class="btn btn-sm btn-outline-secondary">Mark all read</button>
      </form>
    }
  </div>

  @if (!Model.Any())
  {
    <p class="text-muted">No notifications yet.</p>
  }
  else
  {
    <div class="list-group">
      @foreach (var n in Model)
      {
        <div class="list-group-item @(!n.IsRead ? "list-group-item-light fw-semibold" : "")">
          <div class="d-flex justify-content-between">
            <span>@n.Title</span>
            <small class="text-muted">@n.CreatedAt.ToString("d MMM yyyy HH:mm")</small>
          </div>
          <p class="mb-0 fw-normal">@n.Message</p>
        </div>
      }
    </div>
  }
</div>
