@model AaramEducation.Web.Models.ViewModels.Account.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }

<div class="auth-card">
  <h1 class="auth-title">Welcome back</h1>
  <p class="auth-sub">Sign in to continue learning.</p>

  <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="mt-3">
      <label asp-for="Email" class="form-label">Email address</label>
      <input asp-for="Email" class="form-control" autocomplete="email" />
      <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mt-3">
      <label asp-for="Password" class="form-label">Password</label>
      <input asp-for="Password" class="form-control" autocomplete="current-password" />
      <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mt-3 form-check">
      <input asp-for="RememberMe" class="form-check-input" />
      <label asp-for="RememberMe" class="form-check-label">Remember me for 7 days</label>
    </div>

    <button type="submit" class="btn btn-primary w-100 mt-4">Sign in</button>
  </form>

  <p class="text-center mt-3 text-muted small">
    New here? <a asp-action="Register">Create a free account</a>
  </p>
</div>
