@model AaramEducation.Web.Models.ViewModels.Account.LoginViewModel
@{ ViewData["Title"] = "Sign in"; }

<div class="auth-wrap">
  <h1 class="t-h2 text-center mb-2">Welcome back</h1>
  <p class="t-small text-center mb-4">Sign in to pick up where you left off.</p>

  <div class="auth-card">
    <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

      <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
      </div>

      <div class="mb-3">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="At least 8 characters" />
        <span asp-validation-for="Password" class="text-danger small"></span>
      </div>

      <div class="form-check mb-4">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label t-small">Remember me for 7 days</label>
      </div>

      <button type="submit" class="btn-aaram btn-aaram-primary btn-aaram-block">Sign in</button>
    </form>
  </div>

  <p class="t-small text-center mt-4 mb-0">
    New to Aaram? <a asp-action="Register" class="link-aaram">Create an account</a>
  </p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
