@model AaramEducation.Web.Models.ViewModels.Account.ProfileViewModel
@{ ViewData["Title"] = "My Profile"; }

<div class="container py-4" style="max-width:640px">
  <h1 class="mb-4">My Profile</h1>

  @if (TempData["Success"] is string msg)
  {
    <div class="alert alert-success">@msg</div>
  }

  <form asp-action="Profile" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

    <div class="text-center mb-4">
      <img src="@(Model.ProfilePicture ?? "/img/avatar-default.svg")"
           alt="Profile picture" class="rounded-circle" width="96" height="96"
           style="object-fit:cover;border:3px solid var(--aaram-primary)" />
      <div class="mt-2">
        <label for="NewProfilePicture" class="btn btn-sm btn-outline-secondary">Change photo</label>
        <input asp-for="NewProfilePicture" id="NewProfilePicture" type="file"
               accept="image/jpeg,image/png,image/webp" class="visually-hidden" />
        <span asp-validation-for="NewProfilePicture" class="d-block text-danger small"></span>
      </div>
    </div>

    <div class="row g-3">
      <div class="col-6">
        <label asp-for="FirstName" class="form-label">First name</label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger small"></span>
      </div>
      <div class="col-6">
        <label asp-for="LastName" class="form-label">Last name</label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger small"></span>
      </div>
    </div>

    <div class="mt-3">
      <label asp-for="Email" class="form-label">Email address</label>
      <input asp-for="Email" class="form-control" />
      <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <hr class="my-4" />
    <h5 class="mb-3">Change password <small class="text-muted fs-6">(leave blank to keep current)</small></h5>

    <div class="mt-3">
      <label asp-for="NewPassword" class="form-label">New password</label>
      <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
      <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mt-3">
      <label asp-for="ConfirmNewPassword" class="form-label">Confirm new password</label>
      <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
      <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
    </div>

    <div class="mt-4 d-flex gap-2">
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Cancel</a>
    </div>
  </form>
</div>
