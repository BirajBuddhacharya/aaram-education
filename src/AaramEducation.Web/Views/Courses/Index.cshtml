@model AaramEducation.Web.Models.ViewModels.Courses.CourseListViewModel
@{ ViewData["Title"] = "Courses"; }

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h1 class="mb-0">Course Catalog</h1>
    <span class="text-muted small">@Model.Courses.Count() course(s)</span>
  </div>

  <div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="filter-pill @(Model.SelectedSubject is null && Model.SelectedDifficulty is null ? "active" : "")">All</a>
    @foreach (var s in Model.Subjects)
    {
      <a asp-action="Index" asp-route-subject="@s" asp-route-difficulty="@Model.SelectedDifficulty"
         class="filter-pill @(Model.SelectedSubject == s ? "active" : "")">@s</a>
    }
  </div>

  <div class="d-flex gap-2 mb-4 flex-wrap align-items-center">
    <span class="text-muted small">Difficulty:</span>
    @foreach (var d in new[] { "Beginner", "Intermediate", "Advanced" })
    {
      <a asp-action="Index" asp-route-subject="@Model.SelectedSubject" asp-route-difficulty="@d"
         class="filter-pill @(Model.SelectedDifficulty == d ? "active" : "")">@d</a>
    }
    @if (Model.SelectedDifficulty is not null)
    {
      <a asp-action="Index" asp-route-subject="@Model.SelectedSubject" class="filter-pill">Clear</a>
    }
  </div>

  @if (!Model.Courses.Any())
  {
    <div class="text-center py-5 text-muted">
      <p class="fs-5">No courses found.</p>
      <a asp-action="Index" class="btn btn-outline-secondary">Clear filters</a>
    </div>
  }
  else
  {
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      @foreach (var course in Model.Courses)
      {
        var isEnrolled = Model.EnrolledCourseIds.Contains(course.CourseId);
        var diffClass = course.DifficultyLevel.ToLower() switch
        {
          "beginner" => "difficulty-beginner",
          "intermediate" => "difficulty-intermediate",
          "advanced" => "difficulty-advanced",
          _ => ""
        };
        <div class="col">
          <div class="course-card">
            <div class="course-card-header">
              <span class="subject-badge">@course.Subject</span>
              <h5 class="mb-1 mt-1">@course.CourseName</h5>
              <small>by @course.CreatedBy.FirstName @course.CreatedBy.LastName</small>
            </div>
            <div class="course-card-body">
              <p class="text-muted small mb-2">@(course.CourseDescription.Length > 120 ? course.CourseDescription[..120] + "…" : course.CourseDescription)</p>
              <span class="difficulty-badge @diffClass">@course.DifficultyLevel</span>
            </div>
            <div class="course-card-footer">
              <a asp-action="Details" asp-route-id="@course.CourseId"
                 class="btn btn-sm @(isEnrolled ? "btn-outline-primary" : "btn-primary") w-100">
                @(isEnrolled ? "Continue learning" : "View course")
              </a>
            </div>
          </div>
        </div>
      }
    </div>
  }
</div>
