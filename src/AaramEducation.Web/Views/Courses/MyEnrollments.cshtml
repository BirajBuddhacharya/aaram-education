@model AaramEducation.Web.Models.ViewModels.Courses.EnrollmentListViewModel
@{ ViewData["Title"] = "My Courses"; }

<div class="container py-4">
  <h1 class="mb-4">My Courses</h1>

  @if (!Model.Enrollments.Any())
  {
    <div class="text-center py-5">
      <p class="text-muted fs-5">You haven't enrolled in any courses yet.</p>
      <a asp-controller="Courses" asp-action="Index" class="btn btn-primary">Browse courses</a>
    </div>
  }
  else
  {
    @foreach (var e in Model.Enrollments)
    {
      var pct = e.CourseProgress?.PercentComplete ?? 0f;
      var statusClass = e.EnrollmentStatus.ToString() switch
      {
        "Completed" => "text-success",
        "Dropped"   => "text-danger",
        _           => "text-primary"
      };
      <div class="enrollment-card">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div>
            <h5 class="mb-1">
              <a asp-controller="Courses" asp-action="Details" asp-route-id="@e.CourseId">@e.Course.CourseName</a>
            </h5>
            <small class="text-muted">@e.Course.Subject &middot; @e.Course.DifficultyLevel</small>
          </div>
          <span class="@statusClass fw-semibold small">@e.EnrollmentStatus</span>
        </div>

        <div class="mt-3 mb-1">
          <div class="progress-bar-aaram">
            <div class="fill" style="width:@pct.ToString("F0")%"></div>
          </div>
        </div>
        <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted">@pct.ToString("F0")% complete</small>
          <a asp-controller="Courses" asp-action="Details" asp-route-id="@e.CourseId"
             class="btn btn-sm btn-outline-primary">Continue</a>
        </div>
      </div>
    }
  }
</div>
