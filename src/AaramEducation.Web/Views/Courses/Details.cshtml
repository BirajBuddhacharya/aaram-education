@model AaramEducation.Web.Models.ViewModels.Courses.CourseDetailsViewModel
@{
  ViewData["Title"] = Model.Course.CourseName;
  var course = Model.Course;
}

<div class="course-banner">
  <div class="container">
    <span class="subject-badge mb-2">@course.Subject</span>
    <h1 class="mb-1">@course.CourseName</h1>
    <p class="mb-2 opacity-75">by @course.CreatedBy.FirstName @course.CreatedBy.LastName</p>
    <span class="difficulty-badge @(course.DifficultyLevel.ToLower() switch { "beginner" => "difficulty-beginner", "intermediate" => "difficulty-intermediate", _ => "difficulty-advanced" })">
      @course.DifficultyLevel
    </span>
  </div>
</div>

<div class="container pb-5">
  <div class="row g-4">
    <div class="col-lg-8">
      <h4 class="mb-3">Curriculum</h4>
      <div class="accordion" id="curriculumAccordion">
        @foreach (var module in course.Modules.OrderBy(m => m.SequenceOrder))
        {
          var mId = $"module-{module.ModuleId}";
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button"
                      data-bs-toggle="collapse" data-bs-target="#@mId" aria-expanded="false">
                @module.ModuleName
                <span class="ms-2 text-muted small">(@module.Lessons.Count lesson(s))</span>
              </button>
            </h2>
            <div id="@mId" class="accordion-collapse collapse" data-bs-parent="#curriculumAccordion">
              <div class="accordion-body p-0">
                <ul class="list-group list-group-flush">
                  @foreach (var lesson in module.Lessons.OrderBy(l => l.SequenceOrder))
                  {
                    var locked = !Model.IsEnrolled && !lesson.IsFreeSample;
                    <li class="list-group-item d-flex align-items-center gap-2 py-2">
                      @if (locked)
                      {
                        <span title="Enroll to unlock">&#128274;</span>
                      }
                      else
                      {
                        <span>&#127891;</span>
                      }
                      @if (locked)
                      {
                        <span class="text-muted">@lesson.LessonTitle</span>
                      }
                      else
                      {
                        <a asp-controller="Lessons" asp-action="Show" asp-route-id="@lesson.LessonId">@lesson.LessonTitle</a>
                      }
                      @if (lesson.IsFreeSample)
                      {
                        <span class="badge bg-success ms-auto" style="font-size:.65rem">Free preview</span>
                      }
                    </li>
                  }
                </ul>
              </div>
            </div>
          </div>
        }
      </div>

      <div class="mt-4">
        <h4>About this course</h4>
        <p>@course.CourseDescription</p>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="sticky-top" style="top:1rem">
        <div class="course-card">
          <div class="course-card-body">
            @if (Model.IsEnrolled)
            {
              <p class="mb-2 fw-semibold text-success">You are enrolled</p>
              <div class="progress-bar-aaram mb-2">
                <div class="fill" style="width:@(Model.PercentComplete.ToString("F0"))%"></div>
              </div>
              <small class="text-muted">@Model.PercentComplete.ToString("F0")% complete</small>
              <hr />
              <a asp-controller="Courses" asp-action="MyEnrollments" class="btn btn-outline-primary w-100 mb-2">My courses</a>
              <form asp-action="Drop" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="courseId" value="@course.CourseId" />
                <button type="submit" class="btn btn-outline-danger w-100 btn-sm"
                        onclick="return confirm('Drop this course?')">Drop course</button>
              </form>
            }
            else
            {
              <p class="text-muted small mb-3">Enroll to access all lessons, quizzes, and track your progress.</p>
              @if (User.Identity?.IsAuthenticated == true)
              {
                <form asp-action="Enroll" method="post">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="courseId" value="@course.CourseId" />
                  <button type="submit" class="btn btn-primary w-100">Enroll for free</button>
                </form>
              }
              else
              {
                <a asp-controller="Account" asp-action="Login"
                   asp-route-returnUrl="@Context.Request.Path"
                   class="btn btn-primary w-100">Sign in to enroll</a>
              }
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
