@model QuizResultViewModel
@{ ViewData["Title"] = "Quiz Results"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="container py-4" style="max-width:800px">
  <h1 class="mb-1">@Model.Attempt.Quiz.QuizTitle — Results</h1>

  <div class="text-center my-4">
    <div class="display-1 fw-bold @(Model.Passed ? "text-success" : "text-danger")">
      @Model.Attempt.ScoreAchieved%
    </div>
    @if (Model.Passed)
    {
      <span class="badge bg-success fs-5">Passed</span>
    }
    else
    {
      <span class="badge bg-danger fs-5">Failed</span>
    }
    <p class="text-muted mt-2">Passing score: @Model.Attempt.Quiz.PassingScore%</p>
  </div>

  <h5 class="mt-4 mb-3">Question Breakdown</h5>

  @foreach (var q in Model.Attempt.Quiz.Questions.OrderBy(x => x.SequenceOrder))
  {
    var response = Model.Attempt.Responses.FirstOrDefault(r => r.QuestionId == q.QuestionId);
    bool correct = response?.IsCorrect ?? false;
    var correctText = q.Options.FirstOrDefault(o => o.IsCorrect)?.OptionText ?? "N/A";
    var studentText = response?.SelectedOption?.OptionText ?? response?.TextResponse ?? "(no answer)";

    <div class="card mb-3 border-@(correct ? "success" : "danger")">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <p class="fw-semibold mb-2">@q.QuestionText</p>
          <span class="fs-5">@(correct ? "✓" : "✗")</span>
        </div>
        <p class="mb-1 small">
          <span class="text-muted">Your answer:</span> @studentText
        </p>
        @if (!correct)
        {
          <p class="mb-0 small text-success">
            <span class="text-muted">Correct answer:</span> @correctText
          </p>
        }
      </div>
    </div>
  }

  <div class="d-flex gap-3 mt-4">
    <a asp-action="Start" asp-route-quizId="@Model.Attempt.QuizId"
       class="btn btn-outline-primary">Retake Quiz</a>
    <a asp-controller="Lessons" asp-action="Show"
       asp-route-id="@Model.Attempt.Quiz.LessonId"
       class="btn btn-outline-secondary">Back to Lesson</a>
  </div>
</div>
