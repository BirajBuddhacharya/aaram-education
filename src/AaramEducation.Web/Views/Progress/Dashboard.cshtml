@model AaramEducation.Web.Models.ViewModels.Progress.DashboardViewModel
@using AaramEducation.Core.Enums
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="container" style="padding-top:40px;padding-bottom:80px">

  <h1 class="t-h1 mb-5">Welcome back, @Model.Student.FirstName!</h1>

  @* Stat cards *@
  <div class="row g-3 mb-5">
    <div class="col-md-4">
      <div class="card-aaram text-center">
        <div class="t-hero" style="font-size:40px;letter-spacing:-.02em;color:var(--aaram-primary)">@Model.Student.TotalXpPoints</div>
        <div class="t-small mt-1">XP points</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card-aaram text-center">
        <div class="t-hero" style="font-size:40px;letter-spacing:-.02em;color:var(--aaram-amber-text)">@Model.Student.CurrentStreakDays</div>
        <div class="t-small mt-1">Day streak (longest @Model.Student.LongestStreakDays)</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card-aaram text-center">
        <div class="t-hero" style="font-size:40px;letter-spacing:-.02em;color:var(--aaram-primary)">@Model.BadgeCount</div>
        <div class="t-small mt-1">Badges earned</div>
      </div>
    </div>
  </div>

  @* Enrolled courses *@
  <h2 class="t-h3 mb-3">My courses</h2>
  @if (!Model.EnrolledCourses.Any())
  {
    <div class="card-tint mb-5">
      No courses yet. <a asp-controller="Courses" asp-action="Index" class="link-aaram">Browse courses</a> to get started.
    </div>
  }
  else
  {
    <div class="row g-3 mb-5">
      @foreach (var card in Model.EnrolledCourses)
      {
        var pct = Math.Round(card.PercentComplete, 1);
        var statusLabel = card.Status switch
        {
            ProgressStatus.Completed  => "Completed",
            ProgressStatus.InProgress => "In progress",
            _                         => "Not started",
        };
        <div class="col-md-6 col-lg-4">
          <div class="course-card">
            <div class="t-h4">@card.Enrollment.Course.CourseName</div>
            <span class="pill-free align-self-start">@statusLabel</span>
            <div class="progress-bar-aaram green">
              <div class="fill" style="width:@pct%"></div>
            </div>
            <div class="t-xs mb-2">@pct% complete</div>
            <a asp-controller="Courses" asp-action="Details"
               asp-route-id="@card.Enrollment.CourseId"
               class="btn-aaram btn-aaram-outline btn-aaram-sm mt-auto">Continue</a>
          </div>
        </div>
      }
    </div>
  }

  @* Recent badges + week activity *@
  <div class="row g-4">
    <div class="col-md-6">
      <h2 class="t-h3 mb-3">Recent badges</h2>
      @if (!Model.RecentBadges.Any())
      {
        <p class="t-small">No badges yet — keep learning!</p>
      }
      else
      {
        <div class="d-flex flex-column">
          @foreach (var ub in Model.RecentBadges)
          {
            <div class="d-flex align-items-center gap-3" style="padding:14px 0;border-top:1px solid var(--aaram-border)">
              <span class="user-avatar" style="width:38px;height:38px;font-size:16px">@(string.IsNullOrWhiteSpace(ub.Badge.IconUrl) ? "🏅" : "")</span>
              <div>
                <div style="font-weight:700">@ub.Badge.BadgeName</div>
                <div class="t-xs">+@ub.Badge.XpReward XP · @ub.EarnedAt.ToString("MMM d")</div>
              </div>
            </div>
          }
        </div>
        @if (Model.BadgeCount > 3)
        {
          <a asp-controller="Badges" asp-action="Index" class="link-aaram d-inline-block mt-3">View all @Model.BadgeCount badges</a>
        }
      }
    </div>

    <div class="col-md-6">
      <h2 class="t-h3 mb-3">This week</h2>
      @if (!Model.RecentActivity.Any())
      {
        <p class="t-small">No activity yet.</p>
      }
      else
      {
        <table class="table table-sm">
          <thead>
            <tr class="t-xs"><th>Day</th><th>Lessons</th><th>Quizzes</th><th>XP</th></tr>
          </thead>
          <tbody>
            @foreach (var log in Model.RecentActivity)
            {
              <tr>
                <td>@log.ActivityDate.ToString("ddd MMM d")</td>
                <td>@log.LessonsCompleted</td>
                <td>@log.QuizzesPassed</td>
                <td>@log.XpEarned</td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>

</div>
