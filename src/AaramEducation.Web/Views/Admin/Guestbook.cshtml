@model AaramEducation.Web.Models.ViewModels.Admin.AdminGuestbookViewModel
@{ ViewData["Title"] = "Guestbook Moderation"; }

<div class="container py-4" style="max-width:800px">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1>Pending Guestbook Entries</h1>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
  </div>

  @if (!Model.Pending.Any())
  {
    <div class="alert alert-success">No pending entries — all clear!</div>
  }
  else
  {
    @foreach (var entry in Model.Pending)
    {
      <div class="card mb-3">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
            <div>
              <strong>@entry.GuestName</strong>
              @if (!string.IsNullOrWhiteSpace(entry.GuestEmail))
              { <span class="text-muted small ms-2">@entry.GuestEmail</span> }
            </div>
            <span class="text-muted small">@entry.SubmittedAt.ToString("d MMM yyyy HH:mm")</span>
          </div>
          <p class="mb-3">@entry.Message</p>
          <div class="d-flex gap-2">
            <form asp-action="ApproveEntry" method="post" class="m-0">
              @Html.AntiForgeryToken()
              <input type="hidden" name="entryId" value="@entry.EntryId" />
              <button type="submit" class="btn btn-sm btn-success">Approve</button>
            </form>
            <form asp-action="RejectEntry" method="post" class="m-0">
              @Html.AntiForgeryToken()
              <input type="hidden" name="entryId" value="@entry.EntryId" />
              <button type="submit" class="btn btn-sm btn-warning">Reject</button>
            </form>
            <form asp-action="DeleteEntry" method="post" class="m-0"
                  onsubmit="return confirm('Permanently delete this entry?')">
              @Html.AntiForgeryToken()
              <input type="hidden" name="entryId" value="@entry.EntryId" />
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>
    }
  }
</div>
