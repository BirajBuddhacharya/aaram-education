@model AaramEducation.Web.Models.ViewModels.Admin.AdminUserListViewModel
@{ ViewData["Title"] = "Manage Users"; }

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1>Users</h1>
    <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
  </div>

  @if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
  @if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>XP</th>
          <th>Joined</th>
          <th>Change Role</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var u in Model.Users)
        {
          <tr>
            <td>@u.FirstName @u.LastName</td>
            <td class="text-muted small">@u.Email</td>
            <td>
              <span class="badge @(u.Role == AaramEducation.Core.Enums.UserRole.Admin ? "bg-danger" : u.Role == AaramEducation.Core.Enums.UserRole.Tutor ? "bg-warning text-dark" : "bg-secondary")">
                @u.Role
              </span>
            </td>
            <td>@u.TotalXpPoints</td>
            <td class="text-muted small">@u.CreatedAt.ToString("d MMM yyyy")</td>
            <td>
              <form asp-action="ChangeRole" method="post" class="d-flex gap-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@u.UserId" />
                <select name="role" class="form-select form-select-sm" style="width:auto">
                  <option value="Student" selected="@(u.Role == AaramEducation.Core.Enums.UserRole.Student)">Student</option>
                  <option value="Tutor" selected="@(u.Role == AaramEducation.Core.Enums.UserRole.Tutor)">Tutor</option>
                  <option value="Admin" selected="@(u.Role == AaramEducation.Core.Enums.UserRole.Admin)">Admin</option>
                </select>
                <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
              </form>
            </td>
            <td>
              <form asp-action="DeleteUser" method="post"
                    onsubmit="return confirm('Delete @u.Email? This cannot be undone.')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@u.UserId" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
